LOAD DATABASE
     FROM {{SMARTDOCSCAN_SQLSERVER_CONNECTION_STRING}}
     INTO {{SMARTDOCSCAN_POSTGRES_CONNECTION_STRING}}

 WITH include drop, create tables, create indexes, reset sequences,
      foreign keys,
      batch rows = 1000,
      workers = 4,
      concurrency = 1

 SET maintenance_work_mem to '128MB',
     work_mem to '32MB'

 INCLUDING ONLY TABLE NAMES LIKE
     'app_setting',
     'audit_log',
     'box',
     'category',
     'company',
     'company_identity_tenant',
     'documents',
     'patient',
     'user_external_login',
     'users',
     'usersinfo',
     'userinfo'
     IN SCHEMA 'dbo'

 ALTER SCHEMA 'dbo' RENAME TO 'public'

 AFTER LOAD DO
 $$ CREATE UNIQUE INDEX IF NOT EXISTS ux_company_identity_tenant_provider
        ON company_identity_tenant(comp_id, provider, tenant_id); $$,
 $$ CREATE UNIQUE INDEX IF NOT EXISTS ux_user_external_login_provider_subject
        ON user_external_login(provider, tenant_id, subject_id); $$,
 $$ ALTER TABLE documents
        ALTER COLUMN deleted TYPE boolean USING COALESCE(deleted, 0) <> 0,
        ALTER COLUMN deleted SET DEFAULT false; $$,
 $$ ALTER TABLE company
        ALTER COLUMN barcode TYPE boolean USING COALESCE(barcode, 0) <> 0,
        ALTER COLUMN inactive TYPE boolean USING COALESCE(inactive, 0) <> 0; $$,
 $$ ALTER TABLE company_identity_tenant
        ALTER COLUMN enabled TYPE boolean USING COALESCE(enabled, 0) <> 0,
        ALTER COLUMN enabled SET DEFAULT true; $$,
 $$ ALTER TABLE usersinfo
        ALTER COLUMN upload_doc TYPE boolean USING COALESCE(upload_doc, 0) <> 0,
        ALTER COLUMN scan_doc TYPE boolean USING COALESCE(scan_doc, 0) <> 0,
        ALTER COLUMN delete_doc TYPE boolean USING COALESCE(delete_doc, 0) <> 0,
        ALTER COLUMN delete_manage TYPE boolean USING COALESCE(delete_manage, 0) <> 0,
        ALTER COLUMN print_doc TYPE boolean USING COALESCE(print_doc, 0) <> 0,
        ALTER COLUMN download_doc TYPE boolean USING COALESCE(download_doc, 0) <> 0,
        ALTER COLUMN add_cat TYPE boolean USING COALESCE(add_cat, 0) <> 0,
        ALTER COLUMN add_users TYPE boolean USING COALESCE(add_users, 0) <> 0,
        ALTER COLUMN add_patients TYPE boolean USING COALESCE(add_patients, 0) <> 0,
        ALTER COLUMN box TYPE boolean USING COALESCE(box, 0) <> 0,
        ALTER COLUMN report TYPE boolean USING COALESCE(report, 0) <> 0,
        ALTER COLUMN su TYPE boolean USING COALESCE(su, 0) <> 0,
        ALTER COLUMN disabled TYPE boolean USING COALESCE(disabled, 0) <> 0,
        ALTER COLUMN "IsAdmin" TYPE boolean USING COALESCE("IsAdmin", 0) <> 0; $$;
