<ui:FluentWindow x:Class="SmartDocScan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SmartDocScan.Desktop"
        mc:Ignorable="d"
        Title="SmartDocScan Desktop" Height="750" Width="1250"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="SmartDocScan Desktop" Grid.Row="0" />

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Scan Document" 
                               Appearance="Primary" 
                               Command="{Binding ScanDocumentCommand}" 
                               Margin="0,0,10,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Print24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="Refresh" 
                               Appearance="Secondary" 
                               Command="{Binding LoadCategoriesCommand}" 
                               Margin="0,0,10,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:ProgressRing Height="18" Width="18" IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Folder Tree -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Margin="0">
                <DockPanel Margin="10">
                    <TextBlock Text="Categories &amp; Folders" FontWeight="SemiBold" FontSize="14" Margin="5,5,5,10" DockPanel.Dock="Top"/>
                    <TreeView ItemsSource="{Binding Categories}" 
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              BorderThickness="0" 
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubCategories}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" Foreground="#E8B042"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Document Grid -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Documents" FontWeight="SemiBold" FontSize="16" Margin="10,5,10,15" Grid.Row="0"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Documents}" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" 
                         Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="170" Margin="10">
                                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="White" Padding="6">
                                    <StackPanel>
                                        <ui:SymbolIcon Symbol="Document24" FontSize="48" Foreground="#0078D4" Margin="0,20,0,20" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding DocumentName}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" FontWeight="Medium" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Status Bar Footer -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="Gray"/>
        </Border>
    </Grid>
</ui:FluentWindow>
