<ui:FluentWindow x:Class="SmartDocScan.Desktop.Views.ScanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Scanned Document Preview - NAPS2 Engine" Height="720" Width="1050"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="NAPS2 Scan Preview &amp; Page Editor" Grid.Row="0"/>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="#F3F3F3" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Rotate Left" Click="OnRotateLeftClicked" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="Rotate Right" Click="OnRotateRightClicked" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <ui:Button Content="Discard Scan" IsCancel="True" Click="OnDiscardClicked" Margin="0,0,10,0"/>
                    <ui:Button Content="Upload to Cloud" Appearance="Primary" IsDefault="True" Click="OnUploadClicked">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="CloudUpload24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Preview Image Area -->
        <Border Grid.Row="2" Background="#262626" Padding="20">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#FAFAFA" Padding="15,6" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="PageInfoTextBlock" Text="Page 1 of 1 | 300 DPI High Resolution Scan" FontSize="12" Foreground="#666666"/>
        </Border>
    </Grid>
</ui:FluentWindow>
