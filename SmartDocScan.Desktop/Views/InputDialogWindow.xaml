<ui:FluentWindow x:Class="SmartDocScan.Desktop.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Input Prompt" Height="220" Width="420"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Input Required" Grid.Row="0"/>

        <Border Grid.Row="1" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PromptTextBlock" Text="Enter name:" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ui:TextBox x:Name="InputTextBox" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel" IsCancel="True" Click="OnCancelClicked" Margin="0,0,10,0"/>
                    <ui:Button Content="OK" Appearance="Primary" IsDefault="True" Click="OnOkClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
