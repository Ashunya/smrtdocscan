<ui:FluentWindow x:Class="SmartDocScan.Desktop.Views.ScanSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Scanner &amp; NAPS2 Scan Settings" Height="520" Width="560"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Title="NAPS2 Scanner Configuration" Grid.Row="0"/>

        <Border Grid.Row="1" Padding="25">
            <StackPanel VerticalAlignment="Top">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Hardware Scanner:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScannerComboBox" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Storage Location:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LocationComboBox" DisplayMemberPath="Name" Padding="8"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Resolution (DPI):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DpiComboBox" Padding="8">
                            <ComboBoxItem Content="150 DPI (Fast)" />
                            <ComboBoxItem Content="300 DPI (Recommended)" IsSelected="True" />
                            <ComboBoxItem Content="600 DPI (High Detail)" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Color Mode:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ColorComboBox" Padding="8">
                            <ComboBoxItem Content="24-bit Color" IsSelected="True" />
                            <ComboBoxItem Content="Grayscale" />
                            <ComboBoxItem Content="Black &amp; White (Monochrome)" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Paper Source:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SourceComboBox" Padding="8">
                            <ComboBoxItem Content="Flatbed Glass" IsSelected="True" />
                            <ComboBoxItem Content="Document Feeder (ADF)" />
                            <ComboBoxItem Content="Duplex Feeder (Two-sided)" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Page Size:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="SizeComboBox" Padding="8">
                            <ComboBoxItem Content="Letter (8.5 x 11 in)" IsSelected="True" />
                            <ComboBoxItem Content="A4 (210 x 297 mm)" />
                            <ComboBoxItem Content="Legal (8.5 x 14 in)" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="Cancel" IsCancel="True" Click="OnCancelClicked" Margin="0,0,10,0"/>
                    <ui:Button Content="Start NAPS2 Scan" Appearance="Primary" IsDefault="True" Click="OnStartScanClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
